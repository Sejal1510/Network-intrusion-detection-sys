# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Environment / secrets
.env
.env.*
!.env.example

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ML experiment tracking (local runs, not source)
mlruns/
mlartifacts/
mlflow.db
mlflow.db-*

# Trained run artifacts (see nids.training.artifacts)
models/runs/
catboost_info/

# Dataset (fetched via `python -m nids.data.download`, see docs/DATASET.md)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Frontend (frontend/, see docs/DASHBOARD.md) -- package-lock.json IS
# committed (reproducible installs), only build output/deps are ignored
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
