# Copy to .env before `docker compose up` -- see docs/DEPLOYMENT.md.
# docker-compose.yml reads these automatically; Docker Compose loads
# .env from the project root with no extra flag needed.

# Required: a run_id already trained on the host and present under
# models/runs/<run_id>/ (train first with `python -m nids.training`,
# see docs/DATASET.md -- the API never trains, only serves).
NIDS_RUN_ID=

# Optional: a second run_id (e.g. an isolation_forest run) served
# alongside NIDS_RUN_ID for hybrid anomaly detection. Leave blank for
# classifier-only serving.
NIDS_ANOMALY_RUN_ID=

# Required: signs agent pairing tokens (nids.api.agent_auth). Set to a
# random string so a container restart doesn't invalidate
# issued-but-unredeemed pairing tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NIDS_SECRET_KEY=

# Minimum risk score (0-100) that raises an alert.
NIDS_ALERT_THRESHOLD=70

# Origins allowed to call the API cross-origin -- must match wherever
# the frontend is actually served from. Defaults to this compose
# stack's own published frontend port.
NIDS_CORS_ORIGINS=http://localhost:8080

# Root logger level, and 'text' (human-readable) or 'json' (one object
# per line, for log aggregators) -- see docs/OBSERVABILITY.md. Defaults
# to json in compose since a container's stdout is normally read by a
# log driver/aggregator, not a human at a terminal.
NIDS_LOG_LEVEL=INFO
NIDS_LOG_FORMAT=json

# Max requests per minute per client IP to POST /agent/pair +
# /agent/pair/exchange (no auth exists before pairing succeeds, so this
# is their only abuse control) and to POST /predict + /predict/batch
# (both public). See docs/OBSERVABILITY.md.
NIDS_PAIRING_RATE_LIMIT_PER_MINUTE=20
NIDS_INFERENCE_RATE_LIMIT_PER_MINUTE=120

# Largest /predict/batch CSV upload accepted, in bytes, before a 413.
NIDS_MAX_UPLOAD_SIZE_BYTES=10000000

# Optional: Slack incoming-webhook URL / SMTP server for notification
# integrations -- leave all blank to disable (default, zero behavior
# change). See docs/NOTIFICATIONS.md.
NIDS_SLACK_WEBHOOK_URL=
NIDS_SMTP_HOST=
NIDS_SMTP_PORT=587
NIDS_SMTP_USERNAME=
NIDS_SMTP_PASSWORD=
NIDS_SMTP_FROM=
NIDS_SMTP_TO=
NIDS_NOTIFICATION_MIN_SEVERITY=high

# Backend URL the *browser* will call -- baked into the frontend's JS
# bundle at build time, so this must be host-reachable, not a
# Docker-network-internal hostname like "backend". Change this if you
# remap BACKEND_PORT below.
VITE_API_BASE_URL=http://localhost:8000

# Host ports published for each service.
BACKEND_PORT=8000
FRONTEND_PORT=8080
